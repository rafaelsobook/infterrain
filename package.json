{
  "name": "infterrain",
  "version": "1.0.0",
  "description": "Procedural, infinitely-streaming terrain for Babylon.js — chunked heightmap terrain with splat-mapped materials, fogged water, and forest scattering.",
  "main": "./dist/infterrain.js",
  "module": "./dist/infterrain.js",
  "exports": {
    ".": "./dist/infterrain.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch"
  },
  "keywords": [
    "babylonjs",
    "babylon.js",
    "terrain",
    "procedural-generation",
    "infinite-terrain",
    "webgl",
    "game-engine",
    "3d"
  ],
  "author": "Rafael So <rafaelsobook@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rafaelsobook/infterrain.git"
  },
  "license": "ISC",
  "type": "module",
  "peerDependencies": {
    "@babylonjs/core": ">=9.0.0",
    "@babylonjs/loaders": ">=9.0.0"
  },
  "devDependencies": {
    "@babylonjs/core": "^9.18.1",
    "@babylonjs/loaders": "^9.18.1",
    "vite": "^8.1.5"
  }
}
